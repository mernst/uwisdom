CSE:

# Get version number from https://github.com/cli/cli/releases/ .
VER=2.96.0
cd ~/bin/install
wget https://github.com/cli/cli/releases/download/v${VER}/gh_${VER}_linux_amd64.tar.gz
tar xzf gh_${VER}_linux_amd64.tar.gz
mkdir -p ~/bin/`uname`-`uname -m`
cd ~/bin/`uname`-`uname -m`
rm -f gh
ln -s ../install/gh_${VER}_linux_amd64/bin/gh

